ARG RUNTIME_IMAGE=eclipse-temurin:21.0.13_9-jre-alpine@sha256:ac05c3c42b7c2f1a52c9bd52f01041fa1958231b15ebeae7420429cbc5baf474

# ---------- Stage 1: build ----------
FROM maven:3.9.16-eclipse-temurin-21@sha256:99e61abcff91a9b1333463bd8451fb18495d6eba9250ac66a338b518f8278320 AS build

WORKDIR /build

# POMs first: this layer (and the dependency download) is reused by Docker
# as long as no pom.xml changes, even when the source code changes.
# -f builds the module via its own POM; the parent is read only for inheritance, so the other
# modules listed in the root POM don't need to be in the build context.
COPY pom.xml .
COPY portfolio-service/pom.xml ./portfolio-service/
RUN mvn -B -q -f portfolio-service/pom.xml dependency:go-offline

COPY portfolio-service/src ./portfolio-service/src
RUN mvn -B -q -f portfolio-service/pom.xml package -DskipTests

# ---------- Stage 2: runtime ----------
FROM ${RUNTIME_IMAGE}

# Do not run as root inside the container. Alpine (BusyBox) and Ubuntu name the tools differently.
RUN if [ -f /etc/alpine-release ]; then addgroup -S -g 10001 app && adduser -S -u 10001 -G app app; \
    else groupadd --system --gid 10001 app && useradd --system --uid 10001 --gid app app; fi
USER 10001:10001

WORKDIR /app
COPY --from=build /build/portfolio-service/target/portfolio-service-0.0.1-SNAPSHOT.jar app.jar

# UseContainerSupport: read CPU/memory limits from the container (default since JDK 10, set explicitly).
# MaxRAMPercentage=75: max heap = 75% of the container memory limit instead of the default 25%.
ENV JAVA_OPTS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75"

EXPOSE 8083
# sh -c so $JAVA_OPTS is expanded; exec so java becomes PID 1 and receives SIGTERM from Kubernetes
ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /app/app.jar"]
