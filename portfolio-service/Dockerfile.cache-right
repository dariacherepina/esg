# Experiment 2, RIGHT order: dependencies are downloaded before src/ is copied,
# so a change in src/ keeps the dependency layer cached.
FROM maven:3.9.16-eclipse-temurin-21@sha256:99e61abcff91a9b1333463bd8451fb18495d6eba9250ac66a338b518f8278320 AS build
WORKDIR /build
COPY pom.xml .
COPY portfolio-service/pom.xml ./portfolio-service/
RUN mvn -B -q -f portfolio-service/pom.xml dependency:go-offline
COPY portfolio-service/src ./portfolio-service/src
RUN mvn -B -q -f portfolio-service/pom.xml package -DskipTests

FROM eclipse-temurin:21.0.13_9-jre-alpine@sha256:ac05c3c42b7c2f1a52c9bd52f01041fa1958231b15ebeae7420429cbc5baf474
RUN addgroup -S app && adduser -S app -G app
USER app
WORKDIR /app
COPY --from=build /build/portfolio-service/target/portfolio-service-0.0.1-SNAPSHOT.jar app.jar
ENV JAVA_OPTS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75"
EXPOSE 8083
ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /app/app.jar"]
