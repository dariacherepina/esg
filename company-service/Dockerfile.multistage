ARG RUNTIME_IMAGE=eclipse-temurin:21-jre-alpine
# ---------- Stage 1: build ----------
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /build

COPY pom.xml .
COPY company-service/pom.xml ./company-service/
RUN mvn -B -q -f company-service/pom.xml dependency:go-offline

COPY company-service/src ./company-service/src
RUN mvn -B -q -f company-service/pom.xml package -DskipTests

# ---------- Stage 2: runtime ----------
FROM ${RUNTIME_IMAGE}

RUN if [ -f /etc/alpine-release ]; then addgroup -S app && adduser -S app -G app; \
    else groupadd --system app && useradd --system --gid app app; fi
USER app

WORKDIR /app
COPY --from=build /build/company-service/target/company-service-0.0.1-SNAPSHOT.jar app.jar

ENV JAVA_OPTS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75"

EXPOSE 8081
ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /app/app.jar"]
