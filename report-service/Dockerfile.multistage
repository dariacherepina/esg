ARG RUNTIME_IMAGE=eclipse-temurin:21.0.13_9-jre-alpine@sha256:ac05c3c42b7c2f1a52c9bd52f01041fa1958231b15ebeae7420429cbc5baf474

# ---------- Stage 1: build ----------
FROM maven:3.9.16-eclipse-temurin-21@sha256:99e61abcff91a9b1333463bd8451fb18495d6eba9250ac66a338b518f8278320 AS build

WORKDIR /build

COPY pom.xml .
COPY report-service/pom.xml ./report-service/
RUN mvn -B -q -f report-service/pom.xml dependency:go-offline

COPY report-service/src ./report-service/src
RUN mvn -B -q -f report-service/pom.xml package -DskipTests

# ---------- Stage 2: runtime ----------
FROM ${RUNTIME_IMAGE}

# Do not run as root inside the container. Alpine (BusyBox) and Ubuntu name the tools differently.
RUN if [ -f /etc/alpine-release ]; then addgroup -S app && adduser -S app -G app; \
    else groupadd --system app && useradd --system --gid app app; fi
USER app

WORKDIR /app
COPY --from=build /build/report-service/target/report-service-0.0.1-SNAPSHOT.jar app.jar

# UseContainerSupport: read CPU/memory limits from the container (default since JDK 10, set explicitly).
# MaxRAMPercentage=75: max heap = 75% of the container memory limit instead of the default 25%.
ENV JAVA_OPTS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75"

EXPOSE 8084
# sh -c so $JAVA_OPTS is expanded; exec so java becomes PID 1 and receives SIGTERM from Kubernetes
ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /app/app.jar"]
