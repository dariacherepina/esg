# Experiment 2, WRONG order: pom.xml and src/ are copied together, so any change in src/
# invalidates the dependency download as well. Same Maven commands as cache-right.
FROM maven:3.9.16-eclipse-temurin-21@sha256:99e61abcff91a9b1333463bd8451fb18495d6eba9250ac66a338b518f8278320 AS build
WORKDIR /build
COPY pom.xml .
COPY esg-score-service ./esg-score-service
RUN mvn -B -q -f esg-score-service/pom.xml dependency:go-offline
# hadolint ignore=DL3059
RUN mvn -B -q -f esg-score-service/pom.xml package -DskipTests

FROM eclipse-temurin:21.0.13_9-jre-alpine@sha256:ac05c3c42b7c2f1a52c9bd52f01041fa1958231b15ebeae7420429cbc5baf474
RUN addgroup -S -g 10001 app && adduser -S -u 10001 -G app app
USER 10001:10001
WORKDIR /app
COPY --from=build /build/esg-score-service/target/esg-score-service-0.0.1-SNAPSHOT.jar app.jar
ENV JAVA_OPTS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75"
EXPOSE 8082
ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /app/app.jar"]
