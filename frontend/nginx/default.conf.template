# Rendered at container start by the official nginx image: ${VAR} placeholders are replaced with
# environment variables (envsubst). nginx's own variables like $uri are left untouched.
#
# The browser only talks to this server; /api/... is forwarded to the services (reverse proxy),
# so no CORS configuration is needed in any service.

server {
    listen 8080;

    root /usr/share/nginx/html;

    location / {
        try_files $uri /index.html;
    }

    location = /health {
        access_log off;
        default_type text/plain;
        return 200 "UP\n";
    }

    # proxy_pass without a path keeps the original URI: /api/companies/6 -> ${COMPANY_SERVICE_URL}/api/companies/6
    location /api/companies  { proxy_pass ${COMPANY_SERVICE_URL}; }
    location /api/scores     { proxy_pass ${SCORE_SERVICE_URL}; }
    location /api/portfolios { proxy_pass ${PORTFOLIO_SERVICE_URL}; }
    location /api/reports    { proxy_pass ${REPORT_SERVICE_URL}; }

    # a service that is down should fail fast, not hang the page
    proxy_connect_timeout 2s;
    proxy_read_timeout 10s;
}
